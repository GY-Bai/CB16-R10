# Copy to /etc/cb16-ci/relay.env (root) or ~/cb16-ci/relay.env (user) with chmod 600.
GITHUB_WEBHOOK_SECRET=replace_with_high_entropy
CB16_WORKER_TOKEN=replace_with_worker_bearer
GITHUB_RESULT_TOKEN=replace_with_fine_grained_pat
CB16_REPO_URL=https://github.com/GY-Bai/CB16-R10.git
CB16_ALLOWED_REPOS=GY-Bai/CB16-R10
CB16_CI_ROOT=/home/bgy/cb16-ci
CB16_RELAY_ENV=/home/bgy/cb16-ci/relay.env
