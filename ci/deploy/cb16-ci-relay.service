[Unit]
Description=CB16 CI Relay (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bgy
EnvironmentFile=/home/bgy/cb16-ci/relay.env
WorkingDirectory=/home/bgy/cb16-ci/relay
ExecStart=/home/bgy/cb16-ci/relay/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 18787
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
